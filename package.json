{
  "name": "irnetfree-plus",
  "version": "3.2.0",
  "description": "IRNetFree Plus — the tools beside IRNetFree: an IP/SNI scanner for Xray configs (MASQUE, ECH, WARP, Hysteria2, WireGuard) and a local Xray server with a 3x-ui-style panel and reverse proxy",
  "main": "src/main/main.js",
  "author": {
    "name": "IRNetFree",
    "email": "irnetfree@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --require ./tests/noNetwork.preload.js --test \"tests/*.test.js\"",
    "update-cdn-ranges": "node scripts/update-cdn-ranges.js",
    "server": "node src/server/server.js",
    "get-xray": "node scripts/download-xray.js",
    "validate": "node scripts/validate-configs.js",
    "probe:reverse": "node scripts/probe-reverse.js",
    "sync-upstream": "node scripts/sync-upstream.js",
    "gen-icons": "node scripts/gen-icons.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:mac:x64": "electron-builder --mac --x64",
    "dist:mac:arm64": "electron-builder --mac --arm64",
    "dist:linux": "electron-builder --linux",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.irnetfree.plus",
    "productName": "IRNetFree Plus",
    "copyright": "Copyright © IRNetFree",
    "files": [
      "src/**/*",
      "assets/**/*",
      "!**/*.map"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IRNetFree Plus",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "artifactName": "IRNetFree-Plus-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "IRNetFree-Plus-Portable-${version}.${ext}"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "IRNetFree-Plus-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Network",
      "synopsis": "Scanner and local Xray server for Xray configs",
      "maintainer": "IRNetFree <irnetfree@users.noreply.github.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "IRNetFree-Plus-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
